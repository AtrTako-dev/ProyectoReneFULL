IMPORTADO_POR_EMAIL=

# Parámetros del modelo semanal
MIN_SEMANAS_ENTRENAMIENTO=12
MIN_SEMANAS_CON_UNIDADES=8
SEMANAS_EVALUACION=5
ALPHA_RIDGE=1.0

# Solo para la suite de integración con una base desechable
