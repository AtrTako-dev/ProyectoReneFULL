# Copiar este archivo a .env y completar los valores locales.
# .env nunca se sube al repositorio; aqui no se escriben credenciales reales.
# La base debe tener las tablas del contrato (Backend/docs/API_CONTRACT.md, seccion 8).

PUERTO=3000

# Conexion a MySQL 8
DB_HOST=127.0.0.1
DB_PUERTO=3306
DB_USUARIO=renefull_app
DB_CONTRASENA=cambiar_en_entorno_local
DB_NOMBRE=proyecto_renefull

# Firma de tokens de sesion (cadena larga y aleatoria)
JWT_SECRETO=cambiar_por_cadena_larga_aleatoria
JWT_HORAS=8

# Cuenta administradora inicial (usada por: npm run admin:crear)
ADMIN_NOMBRE=Administrador
ADMIN_EMAIL=
ADMIN_CONTRASENA=

# Cuenta cliente activa que recibira las ventas de demostracion (npm run demo:cargar)
DEMO_EMAIL=
# Opcional: directorio alternativo de JSON demo (por defecto Backend/data/demo)
DEMO_DIRECTORIO=
