# Copie este archivo como .env y ajuste los valores locales.
# No incluya contrasenas reales en el repositorio.
#
# El backend completo usa Node.js + Express + MySQL 8. Este bloque configura
# únicamente la base de datos, la carga de datos y el modelo de demanda.
DB_HOST=127.0.0.1
DB_PUERTO=3306
DB_USUARIO=renefull_app
DB_CONTRASENA=
DB_NOMBRE=proyecto_renefull
DB_CONEXIONES=10

# Cuenta cliente de demostración. La contrasena solo se usa al ejecutar
# `npm run demo:cuenta`; no se guarda en el repositorio ni se imprime.
DEMO_EMAIL=cliente.demo@example.com
DEMO_NOMBRE=Cliente de Demostracion
DEMO_PASSWORD=

# Usuario administrador que queda registrado como importador. Es opcional.
IMPORTADO_POR_EMAIL=

# Parámetros del modelo de demanda semanal.
MIN_SEMANAS_ENTRENAMIENTO=12
MIN_SEMANAS_CON_UNIDADES=8
SEMANAS_EVALUACION=5
ALPHA_RIDGE=1.0

# Base desechable usada por las pruebas de integración.
TEST_DB_NOMBRE=proyectorenefull_test
