NODE_ENV=development
DEMO_MODE=false
# Solo para una demostración escolar desplegada; requiere NODE_ENV=production.
ALLOW_PRODUCTION_DEMO_MODE=false
# En Render apunta a un Secret File, por ejemplo /etc/secrets/demo-accounts.json.
DEMO_ACCOUNTS_FILE=
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=more_stock
DB_SSL=false
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_BLOCK_MS=900000
LOGIN_RATE_LIMIT_CLEANUP_INTERVAL_MS=60000
LOGIN_RATE_LIMIT_MAX_TRACKED_KEYS=10000
# Configura solo detrás de una entrada Cloudflare confiable que sobrescriba este encabezado.
LOGIN_RATE_LIMIT_CLIENT_IP_HEADER=
