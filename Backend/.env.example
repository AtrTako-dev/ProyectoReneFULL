# Copiar este archivo a .env y completar los valores locales.
# .env nunca se sube al repositorio; aquí no se escriben credenciales reales.

PUERTO=3000

# Conexión a MySQL
DB_HOST=127.0.0.1
DB_PUERTO=3306
DB_USUARIO=renefull_app
DB_CONTRASENA=cambiar_en_entorno_local
DB_NOMBRE=proyecto_renefull

# Firma de tokens de sesión (cadena larga y aleatoria)
JWT_SECRETO=cambiar_por_cadena_larga_aleatoria
JWT_HORAS=8

# Cuenta administradora inicial (usada por: npm run admin:crear)
ADMIN_EMAIL=
ADMIN_CONTRASENA=

# Cuenta cliente que recibirá las ventas de demostración (usada por: npm run demo:cargar)
DEMO_EMAIL=
