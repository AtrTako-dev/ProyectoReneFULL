# Copia este archivo como .env y ajusta los valores para el entorno local.
# Contiene variables para las dos implementaciones del backend.
# No guardes credenciales reales en el repositorio.

# API Node.js + MySQL
PUERTO=3000
DB_HOST=127.0.0.1
DB_PUERTO=3306
DB_USUARIO=renefull_app
DB_CONTRASENA=cambiar_en_entorno_local
DB_NOMBRE=proyecto_renefull
JWT_SECRETO=cambiar_por_cadena_larga_aleatoria
JWT_HORAS=8
ADMIN_EMAIL=
ADMIN_CONTRASENA=
DEMO_EMAIL=

# Servicios de datos Python + PostgreSQL
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/proyectorenefull
ENTORNO=desarrollo
MIN_SEMANAS_ENTRENAMIENTO=12
MIN_SEMANAS_CON_UNIDADES=8
SEMANAS_EVALUACION=5
DEMO_CLIENTE_CORREO=cliente.demo@example.com
DEMO_CLIENTE_NOMBRE=Cliente de Demostración
ADMIN_CORREO=admin@example.com
ADMIN_NOMBRE=Administrador
