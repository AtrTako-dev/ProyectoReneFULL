# Copie este archivo como .env y ajuste los valores locales.
# .env está excluido de Git; no guarde contraseñas reales en el repositorio.

NODE_ENV=development
PUERTO=3000

# Conexión MySQL 8. La base se crea con `npm run db:migrar`.
DB_HOST=127.0.0.1
DB_PUERTO=3306
DB_USUARIO=renefull_app
DB_CONTRASENA=
DB_NOMBRE=proyecto_renefull
DB_CONEXIONES=10

# Firma de tokens. Use un valor largo y aleatorio en entornos reales.
JWT_SECRETO=
JWT_HORAS=8

# Primera cuenta administradora (`npm run admin:crear`).
ADMIN_NOMBRE=Administrador
ADMIN_EMAIL=
ADMIN_CONTRASENA=

# Cuenta cliente que recibe los datos simulados (`npm run demo:cuenta` y
# `npm run demo:cargar`). La contraseña no se imprime ni se guarda en Git.
DEMO_EMAIL=cliente.demo@example.com
DEMO_NOMBRE=Cliente de Demostracion
DEMO_CONTRASENA=
DEMO_DIRECTORIO=

# Base desechable usada por `npm run test:integracion`.
TEST_DB_NOMBRE=proyectorenefull_test
