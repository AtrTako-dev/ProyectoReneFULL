# Copie este archivo como .env y ajuste los valores locales.
# No incluya contraseñas reales ni secretos en el repositorio.

PUERTO=3000

# MySQL 8
DB_HOST=127.0.0.1
DB_PUERTO=3306
DB_USUARIO=renefull_app
DB_CONTRASENA=
