# Copie este archivo como .env y ajuste los valores locales.
# No incluya contrasenas reales en el repositorio.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/proyectorenefull
ENTORNO=desarrollo

# Parametros del modelo de demanda.
MIN_SEMANAS_ENTRENAMIENTO=12
MIN_SEMANAS_CON_UNIDADES=8
SEMANAS_EVALUACION=5

# Variables usadas por los scripts de demostracion.
# Las contrasenas se solicitan de forma interactiva; no las guarde aqui.
DEMO_CLIENTE_CORREO=cliente.demo@example.com
DEMO_CLIENTE_NOMBRE=Cliente de Demostracion
ADMIN_CORREO=admin@example.com
ADMIN_NOMBRE=Administrador
