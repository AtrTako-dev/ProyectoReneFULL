{
  "name": "renefull-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API ReneFULL y capa de datos y demanda sobre Node.js + MySQL 8",
  "main": "src/servidor.js",
  "scripts": {
    "start": "node src/servidor.js",
    "dev": "node --watch src/servidor.js",
    "test": "node --test pruebas",
    "test:datos:unit": "node --test --test-concurrency=1 pruebas/datos/validacion.test.js pruebas/datos/ml.test.js",
    "test:datos:integracion": "node --test --test-concurrency=1 pruebas/datos/integracion.test.js",
    "db:migrar": "node scripts/migrar.js",
    "demo:cuenta": "node scripts/crearClienteDemo.js",
    "admin:crear": "node scripts/crearAdmin.js",
    "demo:cargar": "node scripts/cargarDemo.js"
  },
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.5"
  }
}
