# Copia este archivo a Backend/.env y define los valores del entorno local.

NODE_ENV=development
PUERTO=3000

# Conexión MySQL 8
DB_HOST=127.0.0.1
DB_PUERTO=3306
DB_USUARIO=renefull_app
DB_CONTRASENA=
DB_NOMBRE=proyecto_renefull
DB_CONEXIONES=10

# JWT_SECRETO debe ser aleatorio y tener al menos 32 caracteres.
JWT_SECRETO=
JWT_HORAS=8

# Cuenta administradora
ADMIN_NOMBRE=Administrador
ADMIN_EMAIL=
ADMIN_CONTRASENA=

# Cuenta y archivos de demostración
DEMO_EMAIL=cliente.demo@example.com
DEMO_NOMBRE=Cliente de Demostracion
DEMO_CONTRASENA=
DEMO_DIRECTORIO=

# Parámetros de estimación
MIN_SEMANAS_ENTRENAMIENTO=12
MIN_SEMANAS_CON_UNIDADES=8
SEMANAS_EVALUACION=5
ALPHA_RIDGE=1.0

# Opcionales: prueba de integración y prueba de humo
TEST_DB_NOMBRE=
# Base URL usada por test:humo; Gradle recibe la suya mediante -PAPI_BASE_URL.
API_BASE_URL=http://127.0.0.1:3000
