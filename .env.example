# Copia este archivo a Backend/.env y configura los valores locales.

NODE_ENV=development
PUERTO=3000

# Conexión MySQL 8
DB_HOST=127.0.0.1
DB_PUERTO=3306
DB_USUARIO=renefull_app
DB_CONTRASENA=
DB_NOMBRE=proyecto_renefull
DB_CONEXIONES=10

# JWT_SECRETO debe ser aleatorio y tener al menos 32 caracteres.
JWT_SECRETO=
JWT_HORAS=8

# Cuenta administradora
ADMIN_NOMBRE=Administrador
ADMIN_EMAIL=
ADMIN_CONTRASENA=

# Cuenta y archivos de demostración
DEMO_EMAIL=cliente.demo@example.com
DEMO_NOMBRE=Cliente de Demostracion
DEMO_CONTRASENA=
DEMO_DIRECTORIO=

# Opcionales: prueba de integración y prueba de humo
# TEST_DB_NOMBRE puede quedar vacío; la integración genera un nombre temporal.
TEST_DB_NOMBRE=
# Dirección usada por npm run test:humo.
API_BASE_URL=http://127.0.0.1:3000
